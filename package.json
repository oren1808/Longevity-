{
  "name": "longevity",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "npm run test -w @longevity/engine",
    "typecheck": "tsc -p packages/engine && tsc -p apps/pilot",
    "dev": "npm run dev -w @longevity/pilot",
    "build": "npm run build -w @longevity/pilot",
    "lint:copy": "node scripts/lint-copy.mjs",
    "check": "npm run typecheck && npm run lint:copy && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
